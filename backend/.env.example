# Copy to backend/.env and adjust as needed.

# --- Database & Redis ---
DATABASE_URL=postgresql+asyncpg://upcheck:upcheck@localhost:5432/upcheck
REDIS_URL=redis://localhost:6379/0
DISPATCH_INTERVAL_SECONDS=30

# --- App ---
DEBUG=false
CORS_ORIGINS=["http://localhost:5173"]
# Public URL of the dashboard (optional; used in alert emails for deep links)
# APP_PUBLIC_URL=https://upcheck.tudominio.com

# --- Email alerts (UP → DOWN) ---
# Set ALERTS_ENABLED=true once SMTP is configured. With false, checks run but no mail is sent.
ALERTS_ENABLED=false

# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-cuenta@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_FROM=upCheck <tu-cuenta@gmail.com>
# SMTP_USE_TLS=true

# Custom domain / transactional provider example (SendGrid SMTP):
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.xxxxxxxxxxxx
# SMTP_FROM=upCheck <alerts@tudominio.com>
# SMTP_USE_TLS=true

# Local dev with MailHog (docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog):
# ALERTS_ENABLED=true
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM=upCheck <dev@localhost>
# SMTP_USE_TLS=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=upCheck <alerts@localhost>
SMTP_USE_TLS=true
